# ============================================================================
# 这个仓库只包含复刻本身的代码。
# 游戏原版素材（音乐 / 音效）与第三方参考实现都不入库：
# 构建脚本会在本地从你自己的 SHENZHEN I/O 安装目录读取它们。
# ============================================================================

# 原版音乐与原版音效（Zachtronics 版权，禁止二次分发）
music/
sfx/
app/music/
app/sfx/

# 打包产物（内含 Electron 运行时与原版素材）
dist/
build/
release/

# 由构建脚本生成的副本（真正的源码在 src/）
app/index.html
app/README.md
app/icon.png

# 第三方参考实现与原版截图（仅本地比对用，各自版权归原作者）
reference/

# 构建时按需下载的工具
tools/pack/rcedit-x64.exe

# 常规忽略
node_modules/
*.log
*.tmp
Thumbs.db
desktop.ini
.DS_Store

# 本地排障用（网络受限时走 API 推送）
tools/push-via-api.ps1
